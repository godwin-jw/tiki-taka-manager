generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  PLAYER
  CAPTAIN
}

enum Position {
  GK
  DEF
  MID
  FWD
}

enum MatchStatus {
  DRAFT
  ONGOING
  COMPLETED
  CANCELLED
}

enum Team {
  A
  B
}

// Membership role inside a crew.
enum CrewRole {
  OWNER
  CAPTAIN
  MEMBER
}

// Lifecycle of a request to join a crew.
enum CrewRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  phone         String?   @unique
  image         String?
  role          Role      @default(PLAYER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts             Account[]
  sessions             Session[]
  ownedGroups          Group[]              @relation("GroupCaptain")
  profiles             GroupPlayerProfile[]
  playerProfile        PlayerProfile?
  createdMatches       Match[]              @relation("MatchCreator")
  playerRatings        PlayerRating[]
  votesCast            PlayerRatingVote[]   @relation("VoteCaster")
  votesReceived        PlayerRatingVote[]   @relation("VoteTarget")
  ownedCrews           Crew[]               @relation("CrewOwner")
  crewMemberships      CrewMember[]
  sentCrewRequests     CrewRequest[]        @relation("CrewRequestSender")
  reviewedCrewRequests CrewRequest[]        @relation("CrewRequestReviewer")
  sentInvitations      CrewInvitation[]     @relation("InvitationSender")
  receivedInvitations  CrewInvitation[]     @relation("InvitationReceiver")
}

model Group {
  id         String   @id @default(cuid())
  name       String
  inviteCode String   @unique
  isPremium  Boolean  @default(false)
  createdAt  DateTime @default(now())

  captainId String
  captain   User   @relation("GroupCaptain", fields: [captainId], references: [id])

  players GroupPlayerProfile[]
  matches Match[]
  ratings Rating[]
}

// Legacy group-specific data stays in its original physical table.
model GroupPlayerProfile {
  id            String   @id @default(cuid())
  positions     Json?
  ovrRating     Float    @default(0)
  pace          Float    @default(0)
  shooting      Float    @default(0)
  passing       Float    @default(0)
  dribbling     Float    @default(0)
  defending     Float    @default(0)
  physical      Float    @default(0)
  goals         Int      @default(0)
  assists       Int      @default(0)
  matchesPlayed Int      @default(0)
  motmCount     Int      @default(0)
  createdAt     DateTime @default(now())

  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  groupId String
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  ratingsGiven    Rating[] @relation("Rater")
  ratingsReceived Rating[] @relation("Ratee")

  @@unique([userId, groupId])
  @@map("PlayerProfile")
}

// One global profile per user, independent of group membership.
model PlayerProfile {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  position      Position @default(MID)
  jerseyNumber  Int?
  ovrRating     Float    @default(0)
  goals         Int      @default(0)
  assists       Int      @default(0)
  matchesPlayed Int      @default(0)
  motmCount     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  appearances MatchPlayer[]
  ratings     PlayerRating[]
  seasonStats PlayerSeasonStat[]

  @@index([ovrRating(sort: Desc), id])
  @@index([goals(sort: Desc), id])
  @@index([assists(sort: Desc), id])
  @@index([motmCount(sort: Desc), id])
  @@map("GlobalPlayerProfile")
}

// A persistent team ("Pro Clubs" crew) of players on the platform.
model Crew {
  id        String   @id @default(cuid())
  name      String
  logo      String?
  createdAt DateTime @default(now())

  // Shareable join link (/davet/<code>). Nullable only so the backfill migration
  // can attach a code to pre-existing crews; every crew created by the app has
  // one. It is an 8-character human-readable token, never a cuid, because people
  // retype and read it out loud.
  inviteCode String? @unique

  // The owner is always a member too; see the seeding logic in the service.
  ownerId String
  owner   User   @relation("CrewOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  members  CrewMember[]
  requests CrewRequest[]
  matches  Match[]
  votes    PlayerRatingVote[]
  invitations CrewInvitation[]

  @@index([name])
  @@map("Crew")
}

// One row per user per crew. Guarantees a single active membership.
model CrewMember {
  id       String   @id @default(cuid())
  role     CrewRole @default(MEMBER)
  joinedAt DateTime @default(now())

  crewId String
  crew   Crew   @relation(fields: [crewId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([crewId, userId])
  @@index([userId])
  @@map("CrewMember")
}

// A player's request to join a crew, reviewed by that crew's captain.
model CrewRequest {
  id         String            @id @default(cuid())
  status     CrewRequestStatus @default(PENDING)
  message    String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  // Set when the request leaves the PENDING state.
  resolvedAt DateTime?

  crewId String
  crew   Crew   @relation(fields: [crewId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation("CrewRequestSender", fields: [userId], references: [id], onDelete: Cascade)

  // Set when a captain accepts or rejects the request.
  reviewedById String?
  reviewedBy   User?   @relation("CrewRequestReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  // Only one open request per person and crew, so the same request is
  // updated instead of stacking up duplicates.
  @@unique([crewId, userId])
  @@index([crewId, status])
  @@index([userId, status])
  @@map("CrewRequest")
}

// A direct, crew-to-player invitation sent inside the app.
//
// This is the mirror image of CrewRequest: a captain invites a specific player
// (receiverId), whereas CrewRequest is a player asking to join (userId). Keeping
// them as separate models means neither can be forged into the other, because the
// receiver of an invitation can only ever act on it themselves.
model CrewInvitation {
  id         String   @id @default(cuid())
  status     CrewRequestStatus @default(PENDING)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  // Set when the invitation leaves the PENDING state.
  resolvedAt DateTime?

  crewId String
  crew   Crew   @relation(fields: [crewId], references: [id], onDelete: Cascade)

  // The captain who sent it; kept for audit and for the "sent" list.
  senderId String
  sender   User   @relation("InvitationSender", fields: [senderId], references: [id], onDelete: Cascade)

  // The invited player. Only this user may accept or reject the invitation.
  receiverId String
  receiver   User   @relation("InvitationReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  // One open invitation per crew and receiver: re-inviting refreshes the row
  // instead of flooding the inbox with duplicates.
  @@unique([crewId, receiverId])
  @@index([receiverId, status])
  @@index([crewId, status])
  @@index([senderId])
  @@map("CrewInvitation")
}

// A competition period. Exactly one season is expected to be active.
model Season {
  id        String   @id @default(cuid())
  name      String   @unique
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())

  matches     Match[]
  playerStats PlayerSeasonStat[]

  @@index([isActive])
  @@map("Season")
}

// Per-season statistics, so each season can be compared and reset.
model PlayerSeasonStat {
  id            String   @id @default(cuid())
  ovrRating     Float    @default(0)
  goals         Int      @default(0)
  assists       Int      @default(0)
  matchesPlayed Int      @default(0)
  motmCount     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  seasonId String
  season   Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  playerProfileId String
  playerProfile   PlayerProfile @relation(fields: [playerProfileId], references: [id], onDelete: Cascade)

  // One stat line per player per season.
  @@unique([seasonId, playerProfileId])
  @@index([playerProfileId])
  @@index([seasonId, goals(sort: Desc)])
  @@index([seasonId, assists(sort: Desc)])
  @@index([seasonId, motmCount(sort: Desc)])
  @@index([seasonId, ovrRating(sort: Desc)])
  @@map("PlayerSeasonStat")
}

// One peer's OVR verdict for a team-mate, cast inside a single crew.
//
// Crew-scoped on purpose: a vote is only valid between two members of the same
// crew, so the unique key is (crewId, voterId, targetUserId). The same pair may
// therefore hold one vote per crew they share, which is why the published OVR
// averages the votes per voter (latest wins) rather than per row.
model PlayerRatingVote {
  id        String   @id @default(cuid())
  // The OVR this peer awards. Kept as an integer 0-99; the database also carries
  // a CHECK constraint so out-of-range rows cannot be written by any path.
  ovrRating Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  crewId String
  crew   Crew   @relation(fields: [crewId], references: [id], onDelete: Cascade)

  voterId String
  voter   User   @relation("VoteCaster", fields: [voterId], references: [id], onDelete: Cascade)

  targetUserId String
  target       User   @relation("VoteTarget", fields: [targetUserId], references: [id], onDelete: Cascade)

  // Re-casting refreshes the existing row instead of stacking duplicates.
  @@unique([crewId, voterId, targetUserId])
  @@index([targetUserId])
  @@index([crewId])
  @@map("PlayerRatingVote")
}

// One equally weighted, editable assessment per voter and global player.
model PlayerRating {
  id              String        @id @default(cuid())
  raterId         String
  rater           User          @relation(fields: [raterId], references: [id], onDelete: Restrict)
  playerProfileId String
  playerProfile   PlayerProfile @relation(fields: [playerProfileId], references: [id], onDelete: Cascade)
  pace            Int
  shooting        Int
  passing         Int
  dribbling       Int
  defending       Int
  physical        Int
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([raterId, playerProfileId])
  @@index([playerProfileId])
}

model Rating {
  id        String   @id @default(cuid())
  pace      Int
  shooting  Int
  passing   Int
  dribbling Int
  defending Int
  physical  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  groupId String
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  raterId String
  rater   GroupPlayerProfile @relation("Rater", fields: [raterId], references: [id], onDelete: Cascade)

  rateeId String
  ratee   GroupPlayerProfile @relation("Ratee", fields: [rateeId], references: [id], onDelete: Cascade)

  @@unique([raterId, rateeId, groupId])
}

model Match {
  id          String      @id @default(cuid())
  date        DateTime
  teamAScore  Int         @default(0)
  teamBScore  Int         @default(0)
  // Custom display names; defaults keep the "A Takımı / B Takımı" wording.
  teamAName   String      @default("A Takımı")
  teamBName   String      @default("B Takımı")
  isCompleted Boolean     @default(false)
  status      MatchStatus @default(ONGOING)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  reportedAt  DateTime?
  createdById String?
  createdBy   User?       @relation("MatchCreator", fields: [createdById], references: [id], onDelete: Restrict)

  groupId      String?
  group        Group?        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  // Retained for the legacy group screens; new matches use players.
  matchDetails Json?
  players      MatchPlayer[]

  // The crew that organised the match, used for crew-scoped archives.
  crewId String?
  crew   Crew?   @relation(fields: [crewId], references: [id], onDelete: SetNull)

  // Season the match counts towards; drives per-season statistics.
  seasonId String?
  season   Season? @relation(fields: [seasonId], references: [id], onDelete: SetNull)

  @@index([status, date(sort: Desc)])
  @@index([groupId, status])
  @@index([createdById])
  @@index([crewId, date(sort: Desc)])
  @@index([seasonId, status])
}

model MatchPlayer {
  id              String        @id @default(cuid())
  matchId         String
  match           Match         @relation(fields: [matchId], references: [id], onDelete: Cascade)
  playerProfileId String
  playerProfile   PlayerProfile @relation(fields: [playerProfileId], references: [id], onDelete: Restrict)
  team            Team
  position        Position
  // Snapshot: future OVR changes must not alter the historical draft.
  ovrAtMatch      Float
  goals           Int           @default(0)
  assists         Int           @default(0)
  isMotm          Boolean       @default(false)

  @@unique([matchId, playerProfileId])
  @@index([playerProfileId, matchId])
  @@index([matchId, team])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
